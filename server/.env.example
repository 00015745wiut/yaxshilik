# Public base URL of THIS server (used to build the Multicard callback URL).
# On localhost the callback is not reachable by Multicard — the app falls back
# to status polling, so demos still work. Use a public URL (or an ngrok tunnel)
# to receive real server-to-server callbacks.
SERVER_URL=http://localhost:5000

